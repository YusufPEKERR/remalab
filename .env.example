# RemaLab WMS - Ortam Değişkenleri ŞABLONU
# Gerçek .env dosyası .gitignore'dadır ve ASLA depoya eklenmemelidir.
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun.

# --- Veritabanı ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=remalab
PG_USER=postgres
PG_PASSWORD=degistir-guclu-bir-sifre

# --- JWT / Oturum imza anahtarı ---
# Güçlü, rastgele bir değer üretin, ör: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Tanımlanmazsa uygulama süreç başına rastgele bir anahtar üretir (yeniden başlatınca değişir).
SECRET_KEY=

# 1 = Vite dev sunucusu (hot-reload), 0 = frontend/dist statik (production)
DEV_MODE=0

# --- Phonecheck API ---
PHONECHECK_APIKEY=
PHONECHECK_USERNAME=
PHONECHECK_REGION=us

# --- Özel GitHub deposu güncelleme tokeni (update.bat) ---
GH_TOKEN=
